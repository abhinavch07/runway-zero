# Get a free token at https://ion.cesium.com (Access Tokens page) and paste it below.
# Leave it empty to run with flat ground and street map imagery.
VITE_CESIUM_ION_TOKEN=

# Optional: your own Google Maps Platform API key with the Map Tiles API enabled, for Google 3D scenery.
# Google charges per session after a free monthly amount. Set a budget alert and a daily cap in Google Cloud.
VITE_GOOGLE_MAPS_KEY=
